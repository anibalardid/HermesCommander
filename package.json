{
  "name": "hermes-commander",
  "version": "0.1.0",
  "private": true,
  "description": "Mission Control for startups and solopreneurs — projects, missions and AI agents over Tailscale.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:server": "npm run dev -w @hermes-commander/server",
    "dev:web": "npm run dev -w @hermes-commander/web"
  },
  "engines": {
    "node": ">=20 <26"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
