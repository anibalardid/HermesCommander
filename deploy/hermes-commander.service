# Hermes Commander daemon — systemd unit (Linux).
# Install:
#   sudo cp deploy/hermes-commander.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hermes-commander
#
# Adjust User/WorkingDirectory/Environment to your setup.

[Unit]
Description=Hermes Commander mission-control daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO_ROOT__
ExecStart=__REPO_ROOT__/deploy/hermes-commander.sh start __REPO_ROOT__
Restart=on-failure
RestartSec=5

Environment=PORT=4310
Environment=HOST=0.0.0.0

[Install]
WantedBy=multi-user.target
